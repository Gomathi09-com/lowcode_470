				displayname = "Related Order"
				values  = food_order.ID
    			displayformat = [order_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_date
			(
    			type = datetime
				displayname = "Payment Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			amount
			(
				displayname = "Amount"
				type = INR
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_method
			(
				type = picklist
				displayname = "Payment Method"
				values = {"Wallet","Cash","Online","Card"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_status
			(
				type = picklist
				displayname = "Payment Status"
				values = {"Failed","Success","Pending","Refunded"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			transaction_reference
			(
    			type = text
				displayname = "Transaction Reference"
	 			row = 1
	 			column = 1   
				width = medium
			)
			payer_name
			(
    			type = name
				displayname = "Payer Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			remarks
			(
    			type = textarea
				displayname = "Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			receipt_url
			(
    			type = url
				displayname = "Receipt URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Payment Initiated","Payment Pending Verification","Payment Cancelled","Payment Processing","Payment Failed","Payment Success","Payment Completed","Payment Refund Initiated","Payment Refunded"}
			}
		}
	}
	reports
	{
		list food_menu_Report
		{
			displayName = "All Food Menus"
			show all rows from food_menu    
			(
				food_name as "Food Name"
				food_code as "Food Code"
				price as "Price"
				(
					display = total,average,min,max	
				)
				description as "Description"
				availability_status as "Availability Status"
				category as "Category"
				type_1 as "Type"
				image_url as "Image URL"
				calories as "Calories"
				is_featured as "Is Featured"
				status as "Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (availability_status == "Available")
				fields = [availability_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (availability_status == "Out of Stock")
				fields = [availability_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban food_menu_by_availability_status
		{
			displayName = "Availability Statuses"
