		form food_order
		{
			displayname = "Food Order"
			success message = "Food Order Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have order_id
			(
    			type = text
				displayname = "Order ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			customer
			(
				type = list	
				displayname = "Customer"
				values  = customer_profile.ID
