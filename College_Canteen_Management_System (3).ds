		workflow
		{
		form
		{
			auto_generate_customer_code as "Auto-Generate Customer Code"
			{
				type =  form
				form = customer_profile

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Auto-generate unique customer code upon new profile creation
										// Check if this is a new record creation (ID is null)
										if(input.ID.isNull())
										{
											// Get current date and time for uniqueness
											currentDateTime = now;
											// Get current user's email for uniqueness
											currentUserEmail = zoho.loginuserid;
											// Extract first 3 characters of email for code prefix
											emailPrefix = currentUserEmail.substring(0,3);
											// Generate timestamp-based unique identifier
											timestamp = currentDateTime.toString("yyyyMMddHHmmss");
											// Combine email prefix and timestamp for unique code
											customerCode = "CUST_".concat(emailPrefix).concat(timestamp);
											// Set the generated customer code to the form field
											input.customer_code = customerCode;
										}
						)
					}
				}

			}
			validate_order_payment_status as "Validate Order Payment Status"
			{
				type =  form
				form = payment_record

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if payment status is failed and cancel submission with alert
										if(input.payment_status.equals("Failed"))
										{
											alert(payment_status,"Cannot submit order with failed payment status. Please resolve the payment issue first.");
											cancel submit;
										}
						)
					}
				}

			}
			Auto_Generate_Item_Number as "Auto Generate Item Number"
			{
				type =  form
				form = order_item

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											Item_Number = "ITM-" + input.ID.toString();
						)
					}
				}

			}
			Automatic_Bill_Calculatio as "Automatic Bill Calculation"
			{
				type =  form
				form = order_item

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.line_total = input.unit_price * input.quantity;
						)
					}
				}

			}
			Fetch_Food_PriceZ as "Fetch Food PriceZ"
			{
				type =  form
				form = order_item

				record event = on add or edit

				on user input of food_item
				{
					actions 
					{
						custom deluge script
						(
											food_record = food_menu[ID == input.food_item];
										input.unit_price = food_record.price;
						)
					}
				}

			}
			Calculate_Line_Total as "Calculate Line Total"
			{
				type =  form
				form = order_item

				record event = on add

				on user input of quantity
				{
					actions 
					{
						custom deluge script
						(
											input.line_total = input.unit_price * input.quantity;
						)
					}
				}

			}
			Calculate_Final_Order_Bil as "Calculate Final Order Bill"
			{
				type =  form
				form = order_item

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											total = 0;
										for each  item in order_item[related_order == input.related_order]
										{
											total = total + ifnull(item.line_total,0);
										}
										order_record = food_order[ID == input.related_order];
										if(order_record.count() > 0)
										{
											order_record.total_amount=total;
										}
						)
					}
				}

			}
			Send_Order_Confirmation_E as "Send Order Confirmation Email"
			{
				type =  form
				form = food_order

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :input.customer.email
											subject :"Your Canteen Order Confirmation"
											message :"Your order " + input.order_id + " has been successfully placed. Thank you for ordering!"
										]
						)
					}
				}

			}
			Payment_Confirmation_Emai as "Payment Confirmation Email"
			{
				type =  form
				form = payment_record

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											order_record = food_order[ID == input.related_order];
										if(order_record.count() > 0)
										{
											customer_record = customer_profile[ID == order_record.customer];
											if(customer_record.count() > 0)
											{
												sendmail
												[
													from :zoho.adminuserid
													to :"sankaragomathi.r.2024.cse@rajalakshmi.edu.in"
													subject :"payment confirmation"
													message :"your payment has been received successfully. thank you for using our college canteen!"
												]
											}
										}
						)
					}
				}

			}
			Notify_Admin_on_New_Order1 as "Notify Admin on New Order"
			{
				type =  form
				form = food_order

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :"sankaragomathi.r.2024.cse@rajalakshmi.edu.in"
											subject :"new food order received"
											message :"a new food order has been placed. order record id: " + input.ID.toString() + ". total amount: " + input.total_amount.toString()
										]
						)
					}
				}

			}
			low_stock_alert as "low_stock_alert"
			{
				type =  form
				form = inventory_transaction

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.available_stock <= input.minimum_stock_level)
										{
											sendmail
											[
												from :zoho.adminuserid
												to :"sankaragomathi.r.2024.cse@rajalakshmi.edu.in"
												subject :"low stock alert"
												message :"low stock alert! the available stock has reached the minimum stock level. please restock the item."
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			notify_low_stock_alert as "Notify Low Stock Alert"
			{
				type =  schedule
				form = inventory_transaction
					status = inactive
				start = transaction_date
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Check if available stock is below minimum stock level
										if(input.available_stock < input.minimum_stock_level)
										{
											// Prepare email details
											emailSubject = "Inventory Alert: Low Stock";
											emailMessage = "Dear Team,\n\n";
											emailMessage = emailMessage.concat("The inventory has dropped below the minimum level.\n");
											emailMessage = emailMessage.concat("Current Stock: ").concat(input.available_stock.toString()).concat("\n");
											emailMessage = emailMessage.concat("Minimum Level: ").concat(input.minimum_stock_level.toString()).concat("\n");
											emailMessage = emailMessage.concat("Transaction ID: ").concat(input.transaction_id);
											// Send email alert
											sendmail
											[
												from :zoho.loginuserid
												to :zoho.loginuserid
												subject :emailSubject
												message :emailMessage
											]
										}
					)
					}
				}
			}
		}


